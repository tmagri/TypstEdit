{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "swift: build",
            "type": "shell",
            "command": "swift build",
            "group": "build",
            "problemMatcher": "$swiftc",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "bundle: app (debug)",
            "type": "shell",
            "command": "./bundle.sh debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$swiftc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "bundle: app (release)",
            "type": "shell",
            "command": "./bundle.sh release",
            "group": "build",
            "problemMatcher": "$swiftc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "swift: clean",
            "type": "shell",
            "command": "swift package clean",
            "problemMatcher": []
        },
        {
            "label": "publish: create installer",
            "type": "shell",
            "command": "./create_dmg.sh",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$swiftc"
        }
    ]
}