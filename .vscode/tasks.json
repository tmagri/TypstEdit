{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "swift: build (arm64)",
            "type": "shell",
            "command": "swift build --scratch-path .build/arch-build/arm64 -c release --arch arm64",
            "options": {
                "env": {
                    "DISABLE_SWIFTLINT": "1"
                }
            },
            "group": "build",
            "problemMatcher": "$swiftc",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "swift: build (Intel x86_64)",
            "type": "shell",
            "command": "swift build --scratch-path .build/arch-build/x86_64 -c release --arch x86_64",
            "options": {
                "env": {
                    "DISABLE_SWIFTLINT": "1"
                }
            },
            "group": "build",
            "problemMatcher": "$swiftc",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "swift: build all (arm64 + Intel x86_64)",
            "dependsOn": [
                "swift: build (arm64)",
                "swift: build (Intel x86_64)"
            ],
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": "$swiftc"
        },
        {
            "label": "swift: build",
            "type": "shell",
            "command": "swift build",
            "group": "build",
            "problemMatcher": "$swiftc",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "bundle: app (debug)",
            "type": "shell",
            "command": "./bundle.sh debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$swiftc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "bundle: app (release)",
            "type": "shell",
            "command": "./bundle.sh release",
            "group": "build",
            "problemMatcher": "$swiftc",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "swift: clean",
            "type": "shell",
            "command": "swift package clean",
            "problemMatcher": []
        },
        {
            "label": "publish: installer (arm64)",
            "detail": "Apple Silicon — arm64-only release DMG",
            "type": "shell",
            "command": "./create_dmg.sh arm64",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$swiftc"
        },
        {
            "label": "publish: installer (Intel x86_64)",
            "detail": "Intel — x86_64-only release DMG",
            "type": "shell",
            "command": "./create_dmg.sh x86_64",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$swiftc"
        },
        {
            "label": "publish: installers (arm64 + Intel x86_64)",
            "dependsOn": [
                "publish: installer (arm64)",
                "publish: installer (Intel x86_64)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": "$swiftc"
        }
    ]
}