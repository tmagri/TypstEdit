{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "swift: build",
            "type": "shell",
            "command": "./bundle.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "swift: clean",
            "type": "shell",
            "command": "swift",
            "args": [
                "package",
                "clean"
            ],
            "problemMatcher": []
        },
        {
            "label": "publish: create installer",
            "type": "shell",
            "command": "./create_dmg.sh",
            "dependsOn": [
                "swift: build"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}